:: StoryScript [script]
Config.debug = false;

setup.initializeVariables = function () {
  const defaults = {
    health: 6,
    hunger: 5,
    trustCats: 5,
    trustHumans: 3
  };

  Object.entries(defaults).forEach(([name, value]) => {
    if (typeof State.variables[name] !== 'number') {
      State.variables[name] = value;
    }
  });
};

setup.adjust = function (name, amount) {
  State.variables[name] = Math.clamp(State.variables[name] + amount, 0, 10);
};

setup.musicVolume = 0.1;

(() => {

  function updateMusicButton(audio) {
    const button = document.getElementById('music-toggle');
    if (!button) {
      return;
    }

    const isPlaying = !audio.paused;
    button.setAttribute('aria-pressed', String(isPlaying));
    button.innerHTML = `<span aria-hidden="true">${isPlaying ? '♫' : '♪'}</span> MUSIC: ${isPlaying ? 'ON' : 'OFF'}`;
  }

  function updateStatusBars() {
    ['health', 'hunger', 'trustCats', 'trustHumans'].forEach((name) => {
      const value = Math.max(0, Math.min(10, Number(State.variables[name]) || 0));
      const valueElement = document.querySelector(`[data-status-value="${name}"]`);
      const fillElement = document.querySelector(`[data-status-fill="${name}"]`);

      if (valueElement) {
        valueElement.textContent = value;
      }
      if (fillElement) {
        fillElement.style.width = `${value * 10}%`;
      }
    });
  }

  function loadSceneMedia() {
    document.querySelectorAll('.scene-media[data-scene-file]').forEach((media) => {
      if (media.querySelector('img, video')) {
        return;
      }

      const file = media.dataset.sceneFile;
      const isVideo = file.toLowerCase().endsWith('.mp4');
      const element = document.createElement(isVideo ? 'video' : 'img');
      element.dataset.file = file;
      const sources = [`assets/${file}`, `../assets/${file}`];
      let sourceIndex = 0;

      media.classList.add('is-loading');
      element.src = sources[sourceIndex];

      if (isVideo) {
        element.autoplay = true;
        element.loop = true;
        element.muted = true;
        element.playsInline = true;
        element.preload = 'metadata';
      } else {
        element.alt = media.getAttribute('aria-label') || 'Scene';
      }

      element.onerror = () => {
        sourceIndex += 1;
        if (sourceIndex < sources.length) {
          element.src = sources[sourceIndex];
          if (isVideo) {
            element.load();
          }
        } else {
          media.classList.remove('is-loading');
          media.classList.add('has-error');
        }
      };
      element.onload = () => media.classList.remove('is-loading');
      if (isVideo) {
        element.addEventListener('loadeddata', () => media.classList.remove('is-loading'), { once: true });
      }
      media.appendChild(element);
    });
  }

  $(document).on(':passagerender', () => {
    const isAlleyEntry = State.passage === 'Alley';

    loadSceneMedia();

    if (isAlleyEntry) {
      window.setTimeout(() => {
        const media = document.querySelector('.scene-media');
        if (!media) {
          return;
        }
        media.classList.add('powering-on');
        window.setTimeout(() => media.classList.remove('powering-on'), 850);
      }, 0);
    }

    updateStatusBars();

    if (!document.querySelector('link[data-neko-favicon]')) {
      const favicon = document.createElement('link');
      favicon.rel = 'icon';
      favicon.type = 'image/svg+xml';
      favicon.href = `data:image/svg+xml,${encodeURIComponent(
        '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">' +
        '<rect width="32" height="32" rx="6" fill="#777b70"/>' +
        '<path d="M7 12 10 5l6 5 6-5 3 7v9c0 4-4 6-9 6s-9-2-9-6z" fill="#26352b"/>' +
        '<circle cx="13" cy="18" r="2" fill="#a0b17f"/>' +
        '<circle cx="21" cy="18" r="2" fill="#a0b17f"/>' +
        '</svg>'
      )}`;
      favicon.dataset.nekoFavicon = 'true';
      document.head.appendChild(favicon);
    }

    let audio = document.getElementById('background-music');
    const shouldStartMusic = !audio;
    if (!audio) {
      audio = document.createElement('audio');
      audio.id = 'background-music';
      audio.loop = true;
      audio.preload = 'none';
      audio.src = 'assets/music.mp3';
      audio.addEventListener('error', () => {
        if (audio.src.endsWith('/assets/music.mp3')) {
          audio.src = '../assets/music.mp3';
        }
      }, { once: true });
      document.body.appendChild(audio);
    }

    if (shouldStartMusic) {
      audio.volume = Math.max(0, Math.min(1, setup.musicVolume));
    }
    updateMusicButton(audio);
    if (shouldStartMusic) {
      audio.play().then(() => updateMusicButton(audio)).catch(() => updateMusicButton(audio));
    }
  });

  $(document).on(':passageend', updateStatusBars);

  const sceneObserver = new MutationObserver(loadSceneMedia);
  sceneObserver.observe(document.body, { childList: true, subtree: true });

  $(document).on('click', '#music-toggle', () => {
    const audio = document.getElementById('background-music');
    if (!audio) {
      return;
    }

    if (audio.paused) {
      audio.play().then(() => updateMusicButton(audio)).catch(() => updateMusicButton(audio));
    } else {
      audio.pause();
      updateMusicButton(audio);
    }
  });

  $(document).on('click', '#restart-game', () => {
    console.log('restart clicked');
    // lowkey nsei pq mas so funfa se eu meter o console log
    if (window.confirm('Restart the game? Your progress will be lost.')) {
      Engine.restart();
    }
  });

  const bgImg = new Image();
  bgImg.src = 'assets/city.gif';
  bgImg.onload = () => {
    document.documentElement.style.setProperty('--bg-image', "url('assets/city.gif')");
  };
  bgImg.onerror = () => {
    document.documentElement.style.setProperty('--bg-image', "url('../assets/city.gif')");
  };
})();

:: StoryStylesheet [stylesheet]
:root {
  --ink: #c5d0d5;
  --muted: #7a718a;
  --panel: rgba(17, 25, 41, 0.96);
  --blue: #6374a3;
  --blue-light: #a49bc4;
  --steel: #3d3951;
  --street: #0c1114;
  --gameboy-shell: #777b70;
  --gameboy-shell-dark: #4c514b;
  --gameboy-shell-red: #913b3b;
  --gameboy-screen: #a0b17f;
  --gameboy-ink: #26352b;
  --link-hover-color: #c4cfaf;
  --bg-image: url('../assets/city.gif');
}

* {
  box-sizing: border-box;
}

body {
  background-color: #0c0a14;
  background-image:
    linear-gradient(rgba(10, 12, 18, 0.65), rgba(10, 12, 18, 0.75)),
    var(--bg-image, url('../assets/city.gif'));
  background-position: center center;
  background-size: cover;
  background-repeat: no-repeat;
  background-attachment: fixed;
  color: var(--ink);
  font-family: 'Segoe UI', Tahoma, sans-serif;
  font-size: 16px;
  min-height: 100vh;
}

#story {
  max-width: 1000px;
  margin: 2rem auto;
  padding: 0 0.25rem 2rem;
}

.game-layout {
  align-items: start;
  display: grid;
  gap: 1rem;
  grid-template-columns: 270px minmax(0, 1fr);
}

.status-sidebar {
  position: sticky;
  top: 1rem;
}

#passages {
  background: linear-gradient(135deg, #929784, var(--gameboy-shell) 58%, #686e61);
  border: 3px solid var(--gameboy-shell-dark);
  border-radius: 1.25rem 1.25rem 2rem 1.25rem;
  box-shadow: 8px 10px 0 rgba(0, 0, 0, 0.35), inset 0 0 0 2px rgba(219, 224, 194, 0.18);
  padding: clamp(1rem, 3vw, 2rem);
  position: relative;
}

.passage {
  color: var(--gameboy-ink);
  font-size: 1.1em;
  line-height: 1.45;
  text-align: justify;
}

.scene-media {
  background: var(--gameboy-screen);
  border: 0.7rem solid #30372f;
  border: 0.6rem solid #30372f;
  clear: both;
  border-radius: 0.3rem;
  display: block;
  box-shadow: inset 0 0 0 0.25rem #586c4d, 0 0.4rem 0 rgba(44, 49, 42, 0.7);
  height: clamp(180px, 26vw, 275px);
  margin: 0 auto 0.35rem;
  max-width: 86%;
  overflow: hidden;
  position: relative;
  visibility: visible;
  z-index: 1;
}

.scene-media.powering-on::after {
  background: #10150f;
  color: #b5c79b;
  content: 'POWER ON';
  display: grid;
  font: 0.8rem 'Courier New', monospace;
  inset: 0;
  letter-spacing: 0.2em;
  opacity: 0;
  place-items: center;
  pointer-events: none;
  position: absolute;
  z-index: 3;
  animation: gameboy-power-on 850ms steps(3, end) forwards;
}

.scene-media.powering-on {
  background: #10150f;
}

.scene-media.powering-on > * {
  visibility: hidden;
}

.scene-media.powering-on .scene-placeholder {
  visibility: visible;
}

@keyframes gameboy-power-on {
  0%, 35% {
    opacity: 1;
  }
  65% {
    opacity: 0.75;
  }
  100% {
    opacity: 0;
  }
}

.scene-media img {
  display: block;
  height: 100%;
  image-rendering: pixelated;
  object-fit: cover;
  width: 100%;
}

.scene-placeholder {
  background:
    linear-gradient(90deg, transparent 0 35%, rgba(38, 53, 43, 0.18) 35% 65%, transparent 65%),
    var(--gameboy-screen);
  display: block;
  inset: 0;
  position: absolute;
  z-index: 0;
}

.scene-media img, .scene-media video {
  position: relative;
  z-index: 1;
}

.scene-media video {
  display: block;
  height: 100%;
  object-fit: cover;
  width: 100%;
}

.scene-media.is-loading::after {
  color: var(--gameboy-ink);
  content: 'LOADING MEDIA...';
  font: 0.75rem 'Courier New', monospace;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
}

.scene-media.has-error::after {
  color: var(--gameboy-ink);
  content: 'MEDIA UNAVAILABLE';
  font: 0.75rem 'Courier New', monospace;
  left: 50%;
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
}

.passage h1, .passage h2, .passage h3 {
  color: var(--gameboy-ink);
  display: flex;
  align-items: center;
  gap: 0.8rem;
  justify-content: space-between;
  font-family: Courier New, monospace;
  font-size: clamp(1.35rem, 3vw, 1.8rem);
  font-weight: 2500;
  line-height: 1.35;
  margin: 0.35rem 0 0.5rem;
  min-width: 0;
  overflow: visible;
  width: 100%;
}

.passage h1::before, .passage h2::before, .passage h3::before {
  color: var(--gameboy-shell-dark);
  content: '✚';
  flex: 0 0 1.5rem;
  font-family: 'Courier New', monospace;
  font-size: 3em;
}

.passage h1::after, .passage h2::after, .passage h3::after {
  background:
    radial-gradient(circle, var(--gameboy-shell-red) 0 45%, transparent 48%) 2.35rem 0.1rem / 2rem 2rem no-repeat,
    radial-gradient(circle, var(--gameboy-shell-red) 0 45%, transparent 48%) 0rem 1.15rem / 2rem 2rem no-repeat;
  color: var(--gameboy-shell-dark) !important;
  content: '';
  display: inline-block;
  flex: 0 0 4.5rem;
  font-family: 'Courier New', monospace;
  font-size: 7rem;
  height: 4rem;
  letter-spacing: 1rem;
  line-height: 2rem;
  min-width: 5rem;
  text-align: center;
  width: 5rem;
}

.scene-media ~ br:has(~ h1, ~ h2, ~ h3) {
  display: none;
}

.passage > br:has(~ .scene-media) {
  display: none;
}

.scene-media + h1,
.scene-media ~ h1,
.scene-media + h2,
.scene-media ~ h2,
.scene-media + h3,
.scene-media ~ h3 {
  margin-top: 0.15rem;
}

.passage ul {
  list-style: none;
  margin: 1.5rem 0 0;
  padding: 0;
}

.passage li {
  margin: 0.65rem 0;
}

/* In-text passage links (links outside list buttons) */
.passage a:not(li a),
.passage a.link-internal:not(li a) {
  background: transparent;
  border: 0;
  box-shadow: none;
  color: var(--gameboy-screen) !important;
  display: inline;
  font-weight: 600;
  overflow-wrap: anywhere;
  padding: 0;
  /* text-decoration: underline; */
}

.passage a:not(li a):hover,
.passage a.link-internal:not(li a):hover {
  background: transparent;
  color: var(--link-hover-color, #ffffff) !important;
  /* text-decoration: underline; */
}

/* Choice action buttons in lists */
.passage li a,
.passage li a.link-internal {
  background: #b5bad3;
  border: 2px solid var(--gameboy-shell-dark);
  border-radius: 0.3rem;
  box-shadow: 0 3px 0 var(--gameboy-shell-dark);
  color: var(--gameboy-ink) !important;
  display: block;
  font-weight: normal;
  padding: 0.7rem 0.9rem;
  text-decoration: none;
}

.passage li a:hover,
.passage li a.link-internal:hover {
  background: #e2e5c7;
  color: #101c16 !important;
  text-decoration: none;
  transform: translateY(1px);
}

/* Hide debug views and debug bar */
#debug-bar,
#debug-bar-hint,
html[data-debug-view] .debug[data-name]::before,
html[data-debug-view] .debug[data-name]::after {
  display: none !important;
}

/* .passage blockquote {
  border-left: 3px solid var(--gameboy-shell-dark);
  color: #344836;
  padding-left: 1rem;
} */

.status-panel {
  background: linear-gradient(135deg, #929784, var(--gameboy-shell) 58%, #686e61);
  border: 2px solid var(--gameboy-shell-dark);
  border-radius: 0.75rem;
  box-shadow: 4px 6px 0 rgba(0, 0, 0, 0.35), inset 0 0 0 1px rgba(219, 224, 194, 0.18);
  color: var(--gameboy-ink);
  display: grid;
  font-family: 'Courier New', monospace;
  font-size: 0.7rem;
  font-weight: 700;
  gap: 0.75rem;
  grid-template-columns: 1fr;
  padding: 0.9rem;
  width: 100%;
}

.status-item {
  align-items: center;
  display: flex;
  gap: 0.6rem;
  min-width: 0;
}

.status-content {
  flex: 1;
  min-width: 0;
}

.status-label {
  color: var(--gameboy-ink);
  display: flex;
  font-weight: 700;
  justify-content: space-between;
}

.status-icon {
  background: var(--gameboy-screen);
  border: 1.5px solid #30372f;
  border-radius: 0.25rem;
  box-shadow: inset 0 0 0 1px #586c4d;
  color: var(--gameboy-ink);
  display: inline-block;
  flex: 0 0 1.8rem;
  font-size: 0.45rem;
  height: 1.8rem;
  letter-spacing: 0.05em;
  line-height: 1.8rem;
  text-align: center;
  width: 1.8rem;
}

.status-icon img {
  display: block;
  filter: brightness(0) opacity(0.85);
  height: 1.2rem;
  margin: 0.25rem;
  width: 1.2rem;
}

.status-bar {
  background: #30372f;
  border: 1.5px solid #20251f;
  border-radius: 0.2rem;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5);
  display: block;
  height: 0.55rem;
  margin-top: 0.3rem;
  overflow: hidden;
  width: 100%;
}

.status-fill {
  background: var(--gameboy-screen);
  box-shadow: 0 0 4px rgba(160, 177, 127, 0.4);
  display: block;
  height: 100%;
  transition: width 180ms ease;
  width: 0;
}

.status-panel b {
  color: var(--gameboy-ink);
  font-size: 0.9rem;
}

.music-toggle {
  background: #b5bad3;
  border: 2px solid var(--gameboy-shell-dark);
  border-radius: 0.3rem;
  box-shadow: 0 3px 0 var(--gameboy-shell-dark);
  color: var(--gameboy-ink);
  cursor: pointer;
  font-family: 'Courier New', monospace;
  font-size: 0.7rem;
  font-weight: 700;
  margin-top: 0.75rem;
  padding: 0.7rem 0.8rem;
  transition: background 150ms ease, color 150ms ease, transform 150ms ease;
  width: 100%;
}

.music-toggle:hover, .music-toggle[aria-pressed='true'] {
  background: #e2e5c7;
  color: #101c16;
  transform: translateY(1px);
}

@media (max-width: 600px) {
  #story {
    margin: 0.75rem auto;
  }

  .game-layout {
    grid-template-columns: 1fr;
  }

  .status-sidebar {
    position: static;
  }

  #passages {
    padding: 1rem;
  }
}

