:: StoryTitle
Neko

:: StoryInterface
<div class="game-layout">
  <aside class="status-sidebar" aria-label="Cat status">
    <div class="status-panel">
  <span class="status-item">
    <span class="status-icon" aria-label="Health icon"><img src="assets/heart.svg" alt="Health icon" onerror="this.onerror = null; this.src = '../assets/heart.svg';"></span>
    <span class="status-content">
      <span class="status-label">HEALTH <b data-status-value="health"><<print $health>></b></span>
      <span class="status-bar"><span class="status-fill" data-status-fill="health" @style="'width: ' + ($health * 10) + '%'"></span></span>
    </span>
  </span>
  <span class="status-item">
    <span class="status-icon" aria-label="Hunger icon"><img src="assets/hunger.svg" alt="Hunger icon" onerror="this.onerror = null; this.src = '../assets/hunger.svg';"></span>
    <span class="status-content">
      <span class="status-label">HUNGER <b data-status-value="hunger"><<print $hunger>></b></span>
      <span class="status-bar"><span class="status-fill" data-status-fill="hunger" @style="'width: ' + ($hunger * 10) + '%'"></span></span>
    </span>
  </span>
  <span class="status-item">
    <span class="status-icon" aria-label="Cats trust icon"><img src="assets/cat.svg" alt="Cats trust icon" onerror="this.onerror = null; this.src = '../assets/cat.svg';"></span>
    <span class="status-content">
      <span class="status-label">TRUST - CATS <b data-status-value="trustCats"><<print $trustCats>></b></span>
      <span class="status-bar"><span class="status-fill" data-status-fill="trustCats" @style="'width: ' + ($trustCats * 10) + '%'"></span></span>
    </span>
  </span>
  <span class="status-item">
    <span class="status-icon" aria-label="Humans trust icon"><img src="assets/person.svg" alt="Humans trust icon" onerror="this.onerror = null; this.src = '../assets/person.svg';"></span>
    <span class="status-content">
      <span class="status-label">TRUST - HUMANS <b data-status-value="trustHumans"><<print $trustHumans>></b></span>
      <span class="status-bar"><span class="status-fill" data-status-fill="trustHumans" @style="'width: ' + ($trustHumans * 10) + '%'"></span></span>
    </span>
  </span>
    </div>
    <button id="music-toggle" class="music-toggle" type="button" aria-pressed="false">
      <span aria-hidden="true">♫</span> MUSIC: OFF
    </button>
    <button id="restart-game" class="music-toggle" type="button">
      <span aria-hidden="true">↺</span> RESTART
    </button>
  </aside>
  <div id="passages"></div>
</div>

